# ---------------------------------------------------------------------------
# DressIt — variables de entorno (copiar a .env; `pnpm db:setup` lo hace por ti)
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# URL pública con la que el móvil alcanza la API (para URLs firmadas de imágenes)
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL 15+ con pgvector. La API usa el rol sin privilegios (RLS);
# las migraciones usan el rol propietario.
DATABASE_URL=postgres://dressit_app:dressit_app_dev@localhost:5432/dressit
DATABASE_ADMIN_URL=postgres://localhost:5432/dressit
DATABASE_TEST_URL=postgres://dressit_app:dressit_app_dev@localhost:5432/dressit_test
DATABASE_TEST_ADMIN_URL=postgres://localhost:5432/dressit_test

REDIS_URL=redis://localhost:6379

# Secretos (≥ 32 caracteres). `pnpm db:setup` genera valores aleatorios en .env.
JWT_SECRET=change-me-change-me-change-me-change-me
IMAGE_URL_SECRET=change-me-too-change-me-too-change-me-too

# Almacenamiento de imágenes: local (desarrollo) o s3 (S3/MinIO/R2…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=eu-south-2
S3_BUCKET=dressit-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Servicio de visión (services/vision)
VISION_SERVICE_URL=http://localhost:8001
VISION_TIMEOUT_MS=120000

# Meteorología: Open-Meteo. Sin clave = API gratuita (solo uso NO comercial).
# Para uso comercial: contratar plan y definir la clave (usa customer-api.open-meteo.com).
OPEN_METEO_API_KEY=

# Importación de enlaces (lectura de una página de producto a petición del usuario)
LINK_IMPORT_USER_AGENT=DressItLinkPreview/0.1 (+https://github.com/Ale-Newport/DressIt; importación a petición del usuario)
LINK_IMPORT_TIMEOUT_MS=10000
LINK_IMPORT_MAX_BYTES=3000000
# Horas tras las que un precio deja de considerarse actual
PRICE_FRESHNESS_HOURS=24

# ---------------------------------------------------------------------------
# Catálogo de tiendas por vías OFICIALES (redes de afiliación / APIs de producto).
# Cada adaptador está DESACTIVADO mientras falten sus credenciales y lo indica en
# Perfil → Integraciones («pendiente de credenciales»). Guía paso a paso para
# conseguir cada valor: docs/conectar-tiendas.md. Comprobar: `pnpm --filter @dressit/api catalog:ingest -- --status`
# Formato de los mapeos tienda=ID: id de tienda de DressIt (ver services/api/src/modules/retail/registry.ts)
# = ID del anunciante/feed en la red. Varios separados por comas: mango=12345,asos=67890
# ---------------------------------------------------------------------------

# Awin (Decathlon, adidas, Lefties, Bimba y Lola, JD Sports, Foot Locker, Sprinter, Privé by Zalando…)
# Tu ID de publisher (número de cuenta de Awin).
AWIN_PUBLISHER_ID=
# Clave de feeds de datos: en Awin → Toolbox → Create-a-Feed, crea un feed y copia lo que va tras «apikey/»
# en el enlace. NO es el token de la API. Con ella + AWIN_PUBLISHER_ID se descubren solos los feeds
# de los anunciantes que te aprueben (los IDs verificados ya están en el registro).
AWIN_PRODUCTDATA_API_KEY=
# Opcional: URLs concretas de Create-a-Feed (CSV/CSV.GZ) o rutas locales, formato tienda=url
AWIN_FEED_URLS=
# Opcional (feeds «Enhanced»/Google en JSONL): token de la API de Awin (Settings → User settings →
# API credentials → Personal Access Token) y los anunciantes a descargar, tienda=ID: decathlon=105405
AWIN_API_TOKEN=
AWIN_ADVERTISERS=
AWIN_FEED_LOCALE=es_ES

# Rakuten Advertising (Mango; posiblemente ASOS y Massimo Dutti): Product Search API.
# Crea una «Application» en developers.rakutenadvertising.com → client id y client secret.
# RAKUTEN_ACCOUNT_ID = tu ID de cuenta de publisher (SID). RAKUTEN_ADVERTISERS = tienda=MID (p. ej. mango=12345).
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_ACCOUNT_ID=
RAKUTEN_ADVERTISERS=

# Tradedoubler: Products API. Token «PRODUCTS» de Account → Manage tokens (40 caracteres hexadecimales).
# TRADEDOUBLER_FEEDS = tienda=ID del feed de producto (p. ej. bershka=12345).
TRADEDOUBLER_PRODUCTS_TOKEN=
TRADEDOUBLER_FEEDS=

# CJ (Commission Junction): Product Feed GraphQL API.
# Personal Access Token (developers.cj.com), CJ_COMPANY_ID = tu CID, CJ_WEBSITE_ID = PID de tu web/app
# (para generar enlaces de afiliado), CJ_ADVERTISERS = tienda=ID del anunciante (p. ej. tous=1234567).
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=
CJ_ADVERTISERS=

# Otras vías (sin adaptador activo todavía)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_ES
EBAY_EPN_CAMPAIGN_ID=
INDITEX_CLIENT_ID=
INDITEX_CLIENT_SECRET=

# Asistente conversacional: funciona sin LLM (motor de reglas). Opcionalmente,
# con clave y consentimiento del usuario, usa un LLM con herramientas.
ANTHROPIC_API_KEY=
ASSISTANT_LLM_MODEL=claude-sonnet-5-5
