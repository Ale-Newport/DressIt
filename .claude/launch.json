{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dressit-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dressit/api",
        "start"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "dressit-vision",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/vision",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://localhost:8001",
      "env": {
        "VISION_PRELOAD": "all"
      }
    },
    {
      "name": "dressit-metro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dressit/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "dressit-imagegen",
      "runtimeExecutable": "services/imagegen/run.sh",
      "runtimeArgs": [],
      "port": 8188
    },
    {
      "name": "dressit-tryon",
      "runtimeExecutable": "services/tryon/run.sh",
      "runtimeArgs": [],
      "port": 8002
    }
  ]
}
