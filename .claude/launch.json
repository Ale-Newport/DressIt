{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dressit-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dressit/api",
        "start"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "dressit-vision",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/vision",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://localhost:8001",
      "env": {
        "VISION_PRELOAD": "all"
      }
    },
    {
      "name": "dressit-metro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dressit/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "dressit-imagegen",
      "runtimeExecutable": "services/imagegen/run.sh",
      "runtimeArgs": [],
      "port": 8188
    },
    {
      "name": "dressit-tryon",
      "runtimeExecutable": "services/tryon/run.sh",
      "runtimeArgs": [],
      "port": 8002
    },
    {
      "name": "dressit-imagegen-mlx",
      "runtimeExecutable": "services/imagegen/run-mlx.sh",
      "runtimeArgs": [],
      "port": 8189,
      "url": "http://localhost:8189"
    },
    {
      "name": "dressit-vision-bench",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/vision",
        "uvicorn",
        "app.main:app",
        "--port",
        "8002"
      ],
      "port": 8002,
      "url": "http://localhost:8002",
      "env": {
        "VISION_PRELOAD": "all"
      }
    },
    {
      "name": "dressit-imagegen-mlx-bench",
      "runtimeExecutable": "services/imagegen/run-mlx.sh",
      "runtimeArgs": [],
      "port": 8190,
      "url": "http://localhost:8190",
      "env": {
        "MLX_PORT": "8190"
      }
    },
    {
      "name": "dressit-api-bench",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dressit/api",
        "start"
      ],
      "port": 3001,
      "url": "http://localhost:3001",
      "env": {
        "API_PORT": "3001",
        "VISION_SERVICE_URL": "http://localhost:8002",
        "IMAGEGEN_MLX_URL": "http://127.0.0.1:8190",
        "API_PUBLIC_URL": "http://localhost:3001"
      }
    }
  ]
}
