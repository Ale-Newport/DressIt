# --- DressIt vision service -------------------------------------------------
# torch = modelos reales; stub = backend determinista SIN modelos (solo tests/CI, /health lo indica)
VISION_BACKEND=torch
# auto | mps | cuda | cpu   (auto: cuda > mps > cpu)
VISION_DEVICE=auto
VISION_PORT=8001
# Caché de pesos (por defecto services/vision/models_cache, ignorada por git). HF_HOME, TORCH_HOME,
# U2NET_HOME y EASYOCR_MODULE_PATH se derivan de ella salvo que se definan explícitamente.
# VISION_MODELS_CACHE=/ruta/a/models_cache
# HF_HOME=/ruta/a/models_cache/hf
# none | embedding | all  — carga de modelos al arrancar (por defecto: perezosa, en la 1.ª petición)
VISION_PRELOAD=none
# Peticiones de análisis simultáneas (límite de memoria); el resto espera turno
VISION_MAX_CONCURRENCY=2
VISION_MAX_UPLOAD_MB=15
VISION_MAX_ITEMS_LIMIT=12
VISION_WORKING_MAX_SIDE=2048
VISION_CUTOUT_MAX_SIDE=1024
# Normalización suave de balance de blancos/exposición del recorte (ver docs/vision.md)
VISION_NORMALIZE_CUTOUT=true
# Limpieza del recorte (docs/vision.md §2): soportes, capas en single y bordes
VISION_REMOVE_SUPPORTS=true
VISION_SUPPORT_MIN_PROB=0.5
VISION_SUPPORT_MIN_PROB_HEAD_FORM=0.25
VISION_SUPPORT_MAX_AREA=0.6
VISION_PROPOSAL_SHORT_SIDE=480
VISION_MAX_PROPOSALS=10
VISION_THIN_BORDER_RADIUS=0.003
VISION_LAYER_SINGLE=true
VISION_DECONTAMINATE_EDGES=true
# macOS: usar CoreML (onnxruntime) para rembg
VISION_ONNX_COREML=true
VISION_SEGMENTER=isnet-general-use
VISION_EMBEDDING_MODEL=Marqo/marqo-fashionSigLIP
VISION_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
VISION_OCR_LANGS=es,en
# Escala softmax global (anula app/calibration.json; normalmente sin definir)
# VISION_LOGIT_SCALE=72.5
# Umbrales de abstención (confianza calibrada mínima para emitir el atributo)
VISION_THRESHOLD_CATEGORY=0.50
VISION_THRESHOLD_SUBCATEGORY=0.40
VISION_THRESHOLD_PATTERN=0.60
VISION_THRESHOLD_MATERIAL=0.70
VISION_THRESHOLD_STYLE=0.50
VISION_THRESHOLD_SEASON=0.60
VISION_THRESHOLD_FIT=0.60
VISION_THRESHOLD_DETECTION=0.18
VISION_THRESHOLD_NOT_GARMENT=0.50
VISION_LOG_LEVEL=INFO
