{
  "name": "@dressit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de DressIt: armario, outfits, meteorología, comercios, compras y asistente",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "worker": "node --env-file-if-exists=../../.env src/worker.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:codegen": "node --env-file-if-exists=../../.env scripts/codegen.ts",
    "db:seed:demo": "node --env-file-if-exists=../../.env scripts/seed-demo.ts",
    "retailers:check": "node --env-file-if-exists=../../.env scripts/check-retailers.ts",
    "catalog:ingest": "node --env-file-if-exists=../../.env scripts/ingest-feed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "maintenance": "node --env-file-if-exists=../../.env scripts/maintenance.ts",
    "cutouts:refresh": "node --env-file-if-exists=../../.env scripts/refresh-cutouts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@dressit/shared": "workspace:*",
    "@dressit/stylist-engine": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.7.9",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.1.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.0.0",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "kysely-codegen": "^0.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
